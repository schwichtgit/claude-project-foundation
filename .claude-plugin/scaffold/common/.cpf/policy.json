{
  "_comment": "cpf hook policy, owned by this project: init seeds it and upgrade never overwrites it. Edit include/exclude globs, severity, and the verify-quality orchestrator here; .prettierignore, .markdownlint-cli2.yaml, and .cpf/shellcheck-excludes.txt are generated from it. The checks runtime (.cpf/runtime/) reads it at every boundary.",
  "hooks": {
    "prettier": {
      "include": ["**/*.md", "**/*.yml", "**/*.yaml", "**/*.json"],
      "exclude": [
        "PLAN.md",
        ".claude/PLAN.md",
        ".claude/mind.*",
        "LICENSE",
        ".cpf/scripts/hooks/pre-commit",
        ".cpf/scripts/hooks/commit-msg"
      ],
      "orchestrator": "none",
      "severity": "error"
    },
    "markdownlint": {
      "include": ["**/*.md"],
      "exclude": [
        ".claude/PLAN.md",
        "node_modules/**",
        "**/node_modules/**",
        ".venv/**",
        "**/.venv/**",
        "**/target/**"
      ],
      "orchestrator": "none",
      "severity": "error"
    },
    "shellcheck": {
      "include": ["**/*.sh"],
      "exclude": [
        "./.git/*",
        "*/.venv/*",
        "*/node_modules/*",
        "*/target/*",
        "*/dist/*"
      ],
      "orchestrator": "none",
      "severity": "error"
    },
    "verify-quality": {
      "orchestrator": "task",
      "severity": "error",
      "on_missing_runner": "warn",
      "on_missing_tests": "skip"
    },
    "format-changed": {
      "severity": "warning"
    },
    "post-edit": {
      "severity": "warning"
    }
  }
}
