{
  "_comment": "plugin-cache lists subtrees authoritative in the plugin; never projected to hosts. Consumers read via cpf_resolve_asset. See ADR-003.",
  "_third_party_tool_config": [
    ".prettierignore",
    ".markdownlint-cli2.yaml",
    ".prettierrc.json",
    ".gitignore"
  ],
  "tiers": {
    "customizable": [".cpf/policy.json"],
    "overwrite": [
      ".cpf/scripts/hooks/pre-commit",
      ".cpf/scripts/hooks/commit-msg",
      ".cpf/scripts/install-hooks.sh",
      ".cpf/scripts/doctor.sh",
      ".github/workflows/ci-base.yml",
      "ci/gitlab/gitlab-ci-base.yml",
      ".cpf/runtime/verify.sh",
      ".cpf/runtime/VERSION",
      ".cpf/runtime/lib/cpf-policy.sh",
      ".cpf/runtime/lib/cpf-shellcheck-fragment.sh",
      ".cpf/runtime/lib/cpf-shellcheck.sh",
      ".cpf/runtime/lib/cpf-tools.sh"
    ],
    "review": [
      ".github/workflows/release.yml",
      ".github/workflows/codeql.yml",
      ".github/CODEOWNERS",
      ".github/dependabot.yml",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/ISSUE_TEMPLATE/bug_report.yml",
      ".github/ISSUE_TEMPLATE/config.yml",
      ".github/ISSUE_TEMPLATE/feature_request.yml",
      "Jenkinsfile",
      ".prettierrc.json",
      "ci/github/repo-settings.md",
      "ci/github/CODEOWNERS.template",
      "ci/github/dependabot.yml",
      "ci/github/PULL_REQUEST_TEMPLATE.md",
      "ci/github/workflows/commit-standards.yml",
      ".gitlab/merge_request_templates/Default.md"
    ],
    "skip": [
      ".github/workflows/ci.yml",
      ".gitlab-ci.yml",
      "CLAUDE.md",
      ".specify/memory/*",
      ".specify/specs/*",
      ".specify/proposals/*",
      "feature_list.json",
      "claude-progress.txt",
      "README.md",
      ".gitignore",
      "init.sh",
      ".cpf/overrides/",
      ".cpf/upstream-cache/",
      ".cpf/pending/"
    ],
    "plugin-cache": [
      ".specify/templates/",
      ".specify/WORKFLOW.md",
      ".specify/doctor-registry.json",
      "prompts/",
      "ci/principles/",
      "ci/gitlab/gitlab-ci-guide.md",
      "ci/jenkins/",
      "CLAUDE.md.template"
    ]
  },
  "migrations": {
    "0.1.0-alpha.12": {
      "policy_seed": true,
      "reorg_paths": [
        "prompts/",
        ".specify/templates/",
        ".specify/WORKFLOW.md",
        "ci/principles/"
      ],
      "jenkinsfile_tier_change": true,
      "v02_countdown": true
    }
  },
  "relocations": {
    "_comment": "New host path -> path the same file had in older releases. Upgrade adopts the host's copy from the old path when the new path is missing, so local edits move with the file.",
    ".cpf/scripts/hooks/pre-commit": "scripts/hooks/pre-commit",
    ".cpf/scripts/hooks/commit-msg": "scripts/hooks/commit-msg",
    ".cpf/scripts/install-hooks.sh": "scripts/install-hooks.sh",
    ".cpf/scripts/doctor.sh": "scripts/doctor.sh"
  }
}
